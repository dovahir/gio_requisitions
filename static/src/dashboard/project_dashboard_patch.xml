<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="gio.ProjectDashboard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_proj_desc_col')]//div[hasclass('o_proj_box')]" position="after">
            <div class="d-flex align-items-center" t-if="isWorkspaceActive('explosion_insumos')">
                <button type="button" class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2 shadow-sm text-nowrap"
                        t-on-click="abrirNuevaRequisicionExplosion"
                        title="Generar requisición para los insumos de esta obra">
                    <i class="fa fa-shopping-cart"/>
                    <span>Nueva Requisición</span>
                </button>
            </div>
        </xpath>
    </t>

</templates>
