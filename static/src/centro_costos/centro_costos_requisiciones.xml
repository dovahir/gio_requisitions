<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gio_requisitions.CentroCostosRequisiciones">
        <div class="o_gio_requisiciones o_gio_costos" t-att-aria-busy="state.loading">
            <!-- Barra de Navegación Integrada del Proyecto -->
            <ProjectWorkspaceNavigation
                context="contexto"
                projectId="projectId"
                initialMainTab="initialMainTab"
                initialSubTab="initialSubTab"
                activeMainTab="initialMainTab"
                activeSubTab="initialSubTab"/>

            <!-- Banners de Validación de Elegibilidad -->
            <div class="px-3 pt-2" t-if="state.data and !state.error">
                <!-- Alerta: Proyecto no congelado -->
                <div t-if="!state.data.congelado" class="alert alert-warning d-flex align-items-center mb-2" role="alert">
                    <i class="fa fa-exclamation-triangle fa-2x me-3 text-warning"/>
                    <div>
                        <strong>Proyecto sin Línea Base Aprobada</strong>
                        <p class="mb-0 small text-muted">
                            Para poder emitir requisiciones de insumos, el proyecto debe contar con una revisión aprobada y congelada.
                        </p>
                    </div>
                </div>

                <!-- Alerta: Falta ubicación de almacén -->
                <div t-if="state.data.congelado and !state.data.configurado_almacen" class="alert alert-danger d-flex align-items-center justify-content-between mb-2" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-map-marker fa-2x me-3 text-danger"/>
                        <div>
                            <strong>Ubicación de Almacén de Obra Pendiente</strong>
                            <p class="mb-0 small text-muted">
                                El proyecto no tiene una ubicación física asignada. Es obligatorio designarla antes de solicitar materiales.
                            </p>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-danger ms-3" t-on-click="abrirAlmacenConfiguracion">
                        Configurar Almacén
                    </button>
                </div>
            </div>

            <!-- KPIs y Métricas de Requisiciones de Obra (Mismo Sistema de Diseño Homogéneo) -->
            <section class="o_gio_costos_kpis px-3 py-2" t-if="state.data and !state.error">
                <div class="row g-2 mb-3">
                    <!-- Tarjeta 1: Requisiciones de Obra en Borrador -->
                    <div class="col-12 col-sm-6 col-md-4 col-xl">
                        <div class="card h-100 border-0 shadow-sm o_kpi_card o_kpi_card_info"
                             t-on-click="() => this.filtrarPorEstado('draft')"
                             role="button" tabindex="0">
                            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center">
                                    <div class="o_kpi_icon_wrapper rounded-3 d-flex align-items-center justify-content-center me-3">
                                        <i class="fa fa-pencil-square-o fa-lg"/>
                                    </div>
                                    <div>
                                        <div class="o_kpi_value fw-bold" t-esc="state.data.conteo_estados.draft"/>
                                        <div class="o_kpi_title fw-semibold">Borradores de Obra</div>
                                        <div class="mt-1">
                                            <span class="badge rounded-pill o_kpi_badge_info small">En Captura</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kpi_arrow text-muted">
                                    <i class="fa fa-chevron-right"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta 2: Por Aprobar -->
                    <div class="col-12 col-sm-6 col-md-4 col-xl">
                        <div t-attf-class="card h-100 border-0 shadow-sm o_kpi_card #{state.data.conteo_estados.to_approve > 0 ? 'o_kpi_card_warning' : 'o_kpi_card_info'}"
                             t-on-click="() => this.filtrarPorEstado('to_approve')"
                             role="button" tabindex="0">
                            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center">
                                    <div class="o_kpi_icon_wrapper rounded-3 d-flex align-items-center justify-content-center me-3">
                                        <i class="fa fa-clock-o fa-lg"/>
                                    </div>
                                    <div>
                                        <div class="o_kpi_value fw-bold" t-esc="state.data.conteo_estados.to_approve"/>
                                        <div class="o_kpi_title fw-semibold">Por Aprobar</div>
                                        <div class="mt-1">
                                            <span t-attf-class="badge rounded-pill #{state.data.conteo_estados.to_approve > 0 ? 'o_kpi_badge_warning' : 'o_kpi_badge_info'} small">En Revisión</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kpi_arrow text-muted">
                                    <i class="fa fa-chevron-right"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta 3: Insumos en Camino / Traslado a Obra -->
                    <div class="col-12 col-sm-6 col-md-4 col-xl">
                        <div class="card h-100 border-0 shadow-sm o_kpi_card o_kpi_card_primary"
                             t-on-click="() => this.filtrarPorEstado('in_progress')"
                             role="button" tabindex="0">
                            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center">
                                    <div class="o_kpi_icon_wrapper rounded-3 d-flex align-items-center justify-content-center me-3">
                                        <i class="fa fa-truck fa-lg"/>
                                    </div>
                                    <div>
                                        <div class="o_kpi_value fw-bold" t-esc="state.data.conteo_estados.in_progress"/>
                                        <div class="o_kpi_title fw-semibold">En Camino a Obra</div>
                                        <div class="mt-1">
                                            <span class="badge rounded-pill o_kpi_badge_primary small">En Suministro</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kpi_arrow text-muted">
                                    <i class="fa fa-chevron-right"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta 4: Surtidas en Obra -->
                    <div class="col-12 col-sm-6 col-md-4 col-xl">
                        <div class="card h-100 border-0 shadow-sm o_kpi_card o_kpi_card_success"
                             t-on-click="() => this.filtrarPorEstado('done')"
                             role="button" tabindex="0">
                            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center">
                                    <div class="o_kpi_icon_wrapper rounded-3 d-flex align-items-center justify-content-center me-3">
                                        <i class="fa fa-check-circle fa-lg"/>
                                    </div>
                                    <div>
                                        <div class="o_kpi_value fw-bold" t-esc="state.data.conteo_estados.done"/>
                                        <div class="o_kpi_title fw-semibold">Surtidas en Obra</div>
                                        <div class="mt-1">
                                            <span class="badge rounded-pill o_kpi_badge_success small">Recibidas</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kpi_arrow text-muted">
                                    <i class="fa fa-chevron-right"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta 5: Alerta Presupuestal APU (Excedentes) -->
                    <div class="col-12 col-sm-6 col-md-4 col-xl">
                        <div t-attf-class="card h-100 border-0 shadow-sm o_kpi_card #{state.data.kpis_insumos.hay_excedente_requisitado ? 'o_kpi_card_danger' : 'o_kpi_card_success'}"
                             role="button" tabindex="0">
                            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center">
                                    <div class="o_kpi_icon_wrapper rounded-3 d-flex align-items-center justify-content-center me-3">
                                        <i class="fa fa-exclamation-triangle fa-lg"/>
                                    </div>
                                    <div>
                                        <div class="o_kpi_value fw-bold">
                                            <t t-if="state.data.kpis_insumos.hay_excedente_requisitado">
                                                +<t t-esc="state.data.kpis_insumos.excedente_requisitado"/>
                                            </t>
                                            <t t-else="">
                                                0
                                            </t>
                                        </div>
                                        <div class="o_kpi_title fw-semibold">Alerta APU</div>
                                        <div class="mt-1">
                                            <span t-attf-class="badge rounded-pill #{state.data.kpis_insumos.hay_excedente_requisitado ? 'o_kpi_badge_danger' : 'o_kpi_badge_success'} small">
                                                <t t-if="state.data.kpis_insumos.hay_excedente_requisitado">Excedente APU</t>
                                                <t t-else="">Presupuesto OK</t>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kpi_arrow text-muted">
                                    <i class="fa fa-chevron-right"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Barra de Acción y Ubicación -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 bg-white rounded-3 shadow-sm border mb-3">
                    <div class="d-flex align-items-center text-muted small">
                        <i class="fa fa-map-marker text-danger me-2 fa-lg"/>
                        <span>Ubicación de Obra: <strong class="text-dark"><t t-esc="state.data.ubicacion_almacen or 'Pendiente de asignar'"/></strong></span>
                        <span class="mx-2">•</span>
                        <span>Avance Global: <strong class="text-success"><t t-esc="state.data.kpis_insumos.pct_suministrado"/>%</strong></span>
                    </div>
                    <button class="btn btn-primary d-flex align-items-center gap-2 px-3 py-1 fw-semibold shadow-sm"
                            t-att-disabled="state.busy or state.loading or !state.data?.puede_crear"
                            t-on-click="crearRequisicion"
                            t-att-title="state.data?.puede_crear ? 'Generar requisición desde la explosión de insumos' : 'Requiere perfil de Planeador de Obra o Solicitante'">
                        <i class="fa fa-plus"/> Nueva Requisición de Obra
                    </button>
                </div>
            </section>

            <!-- Contenido Principal: Filtros y Tabla -->
            <main class="o_gio_costos_content px-3 pb-3">
                <div t-if="state.error" class="alert alert-danger" role="alert">
                    <t t-esc="state.error"/>
                    <button class="btn btn-sm btn-outline-danger ms-3" t-on-click="() => this.load(0)">Reintentar</button>
                </div>

                <div t-elif="state.loading and !state.data" class="text-center py-5">
                    <i class="fa fa-circle-o-notch fa-spin fa-2x text-primary mb-2"/>
                    <p class="text-muted">Cargando requisiciones del proyecto…</p>
                </div>

                <section t-else="" class="o_gio_costos_documents">
                    <!-- Barra de Búsqueda y Filtros -->
                    <form class="o_gio_costos_filters d-flex flex-wrap align-items-center gap-2 mb-3 o_proj_box p-2" t-on-submit="buscar">
                        <label class="o_gio_costos_search flex-grow-1">
                            <span class="visually-hidden">Buscar requisición</span>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="fa fa-search text-muted"/></span>
                                <input type="search" class="form-control" t-model="state.filtros.buscar" placeholder="Buscar folio, solicitante o autorizador…"/>
                            </div>
                        </label>
                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted">Estado:</span>
                            <select class="form-select form-select-sm" t-model="state.filtros.estado" t-on-change="() => this.load(0)">
                                <option value="">Todos</option>
                                <option t-foreach="state.data.estados" t-as="est" t-key="est[0]" t-att-value="est[0]">
                                    <t t-esc="est[1]"/>
                                </option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted">Desde:</span>
                            <input type="date" class="form-control form-control-sm" t-model="state.filtros.desde"/>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted">Hasta:</span>
                            <input type="date" class="form-control form-control-sm" t-model="state.filtros.hasta"/>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary" type="submit" t-att-disabled="state.loading">Filtrar</button>
                        <button t-if="hayFiltros" class="btn btn-sm btn-link text-decoration-none" type="button" t-on-click="limpiar">Limpiar</button>
                    </form>

                    <!-- Resumen del Listado -->
                    <div class="d-flex justify-content-between align-items-center mb-2 text-muted small">
                        <span><strong><t t-esc="state.data.total"/></strong> requisiciones encontradas</span>
                        <span t-if="state.loading"><i class="fa fa-spinner fa-spin me-1"/> Actualizando…</span>
                    </div>

                    <!-- Tabla de Documentos -->
                    <div t-if="state.data.filas.length" class="table-responsive shadow-sm rounded o_gio_costos_table_container">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Folio</th>
                                    <th>Fecha Requerida</th>
                                    <th>Solicitante</th>
                                    <th>Autoriza</th>
                                    <th>Almacén</th>
                                    <th class="text-center">Ítems</th>
                                    <th class="text-center">Avance Suministro</th>
                                    <th class="text-center">Estado</th>
                                    <th/>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.data.filas" t-as="fila" t-key="fila.id" style="cursor: pointer;" t-on-click="() => this.abrirRequisicion(fila.id)">
                                    <td class="fw-bold text-primary">
                                        <t t-esc="fila.name"/>
                                    </td>
                                    <td><t t-esc="fila.fecha_requerida"/></td>
                                    <td><t t-esc="fila.solicitante"/></td>
                                    <td class="text-muted"><t t-esc="fila.autoriza"/></td>
                                    <td><t t-esc="fila.almacen"/></td>
                                    <td class="text-center">
                                        <span class="badge border o_gio_badge_items">
                                            <t t-esc="fila.total_lineas"/> partidas (<t t-esc="fila.total_items"/> uds)
                                        </span>
                                    </td>
                                    <td class="text-center" style="min-width: 140px;">
                                        <div class="progress" style="height: 16px;">
                                            <div class="progress-bar bg-success" role="progressbar"
                                                 t-att-style="'width: ' + fila.pct_surtido + '%;'"
                                                 t-att-aria-valuenow="fila.pct_surtido" aria-valuemin="0" aria-valuemax="100">
                                                <small><t t-esc="fila.pct_surtido"/>%</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span t-att-class="'badge ' + badgeEstadoClass(fila.estado)">
                                            <t t-esc="fila.estado_label"/>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" title="Abrir Requisición" aria-label="Abrir Requisición">
                                            <i class="fa fa-angle-right"/>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Estado Vacío -->
                    <div t-else="" class="o_proj_box text-center py-5">
                        <i class="fa fa-shopping-cart fa-3x text-muted mb-3"/>
                        <h5 class="fw-semibold text-secondary">
                            <t t-esc="hayFiltros ? 'No se encontraron requisiciones con estos filtros' : 'Aún no se han generado requisiciones para este proyecto'"/>
                        </h5>
                        <p class="text-muted small mb-3">
                            <t t-esc="hayFiltros ? 'Prueba ajustando los criterios de búsqueda o fecha.' : 'Genera requisiciones para solicitar insumos directamente desde el presupuesto de la obra.'"/>
                        </p>
                        <button t-if="!hayFiltros and state.data?.puede_crear" class="btn btn-sm btn-primary" t-on-click="crearRequisicion">
                            <i class="fa fa-plus me-1"/> Crear Primera Requisición
                        </button>
                    </div>

                    <!-- Paginador -->
                    <footer t-if="state.data.total > 0" class="d-flex justify-content-between align-items-center mt-3 text-muted small">
                        <span>Mostrando <t t-esc="desdeFila"/>–<t t-esc="hastaFila"/> de <t t-esc="state.data.total"/></span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" t-att-disabled="state.loading or state.pagina == 0" t-on-click="() => this.load(state.pagina - 1)">
                                <i class="fa fa-angle-left"/> Anterior
                            </button>
                            <button class="btn btn-outline-secondary" t-att-disabled="state.loading or hastaFila >= state.data.total" t-on-click="() => this.load(state.pagina + 1)">
                                Siguiente <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                    </footer>
                </section>
            </main>
        </div>
    </t>
</templates>
